apiVersion: v1
kind: Secret
metadata:
  name: go-rest-api-secrets
  namespace: go-rest-api
type: Opaque
# This file is a template, not a deployable Secret: it is tracked so a
# reader can see the required keys, while the real 11-secret.yaml is
# git-ignored because it carries credentials. Create the real one with:
#
#   cp deploy/k8s/11-secret.yaml.example deploy/k8s/11-secret.yaml
#   kubectl apply -f deploy/k8s/11-secret.yaml
stringData:
  # Generate with: openssl rand -base64 48
  JWT_SECRET: "change-me-to-a-long-random-secret-of-at-least-32-bytes"

  # Format: postgres://user:password@host:port/db?sslmode=require
  DATABASE_URL: "postgres://postgres:postgres@postgres:5432/go_lang?sslmode=disable"

  # Format: redis://[user:password@]host:port/db (rediss:// for TLS)
  REDIS_URL: "redis://redis:6379/0"
